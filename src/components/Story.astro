---
interface Props {
  id: string;
  title: string;
  holdFaculty?: boolean;
}

const { id, title, holdFaculty = false } = Astro.props;
---

<article class="story" aria-labelledby={`${id}-heading`}>
  <div id={id} class="article-transition" tabindex="-1">
    <div class="slide slide--student" data-slide data-pin data-card-fade>
      <div class="student-heading">
        <h2 id={`${id}-heading`}>{title}</h2>
        <a class="back-to-soup" href="#soup">↑ Back to the soup</a>
      </div>
      <slot name="student" />
    </div>
    <div class="slide slide--article" data-slide>
      <slot name="article" />
    </div>
  </div>
  <div class="faculty-transition">
    <div class="slide slide--faculty" data-slide data-card-fade data-pin={holdFaculty ? '' : undefined}>
      <slot name="faculty" />
    </div>
  </div>
</article>

<style>
  .article-transition {
    /* Cancel the page's anchor offset so the slide lands at the viewport top. */
    scroll-margin-top: calc(0px - var(--header-height) - 1px);
  }

  .slide--student {
    --student-inset: calc(var(--slide-viewport) * 0.05);
    --student-title-size: clamp(3rem, 6vw, 6rem);
    --student-gap: clamp(0.75rem, 2vh, 1.5rem);
    /* Reserve room for the name, audio controls and collapsed transcript. */
    --student-portrait-height: max(
      8rem,
      calc(var(--slide-viewport) * 0.9 - var(--student-title-size) - var(--student-gap) - 7.5rem)
    );
    display: grid;
    align-content: center;
    gap: var(--student-gap);
    padding-block: var(--student-inset);
  }

  .student-heading,
  .story :global(.interview-card) {
    width: 80%;
    margin-inline: auto;
  }

  .student-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h2 {
    margin: 0;
    font: 400 var(--student-title-size) / 1 var(--font-display);
    color: var(--dark-red);
  }

  .back-to-soup {
    font: 400 1.7rem / 1.2 "alphabet-soup-pro", sans-serif;
    color: var(--dark-red);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transform-origin: right center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .back-to-soup {
      transition: transform 250ms cubic-bezier(0.2, 0.75, 0.35, 1.1);
    }

    .back-to-soup:is(:hover, :focus-visible) {
      transform: scale(1.12);
    }
  }

  .story :global(.interview-card) {
    min-width: 0;
    display: grid;
    align-items: center;
  }

  .story :global(.interview-grid) {
    display: grid;
    grid-template-columns: var(--interview-columns, minmax(0, 1fr) minmax(0, 1fr));
    align-items: center;
    gap: clamp(1.5rem, 5vw, 6rem);
  }

  @media (max-width: 700px) {
    .slide--faculty :global(.interview-card) {
      width: calc(100% - 2rem);
    }

    .story :global(.interview-grid) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
