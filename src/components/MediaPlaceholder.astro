---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="placeholder">{label}</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: var(--media-ratio, 4 / 3);
    padding: 1rem;
    background: var(--media-surface, var(--tan));
    font-weight: 700;
    text-align: center;
  }
</style>
