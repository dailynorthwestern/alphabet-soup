---
import MediaPlaceholder from './MediaPlaceholder.astro';
import type { MarkdownInstance } from 'astro';

interface ArticleFrontmatter {
  headline?: string;
  reporter?: string;
  reporterUrl?: string;
}

interface Props {
  title: string;
  article: MarkdownInstance<ArticleFrontmatter>;
}

const { title, article } = Astro.props;
const { Content, frontmatter: { headline, reporter, reporterUrl } } = article;
const hasContent = Boolean(article.rawContent().replace(/<!--[\s\S]*?-->/g, '').trim());
---

<section class="story-content" aria-label={`${title} story`}>
  {(headline || reporter) && (
    <header class="article-header">
      {headline && <h3 class="headline">{headline}</h3>}
      {reporter && (
        <p class="byline">By {reporterUrl ? <a href={reporterUrl}>{reporter}</a> : reporter}</p>
      )}
    </header>
  )}
  <div class="article-body">
    {hasContent ? <Content /> : (
      <>
        <h3>Heading placeholder</h3>
        <p>Paragraph placeholder</p>
        <MediaPlaceholder label="Story image placeholder" />
        <p>Paragraph placeholder</p>
      </>
    )}
  </div>
</section>

<style>
  .story-content {
    width: 60%;
    margin-inline: auto;
    padding-block: clamp(3rem, 7vw, 7rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    --article-headline-font: var(--font-body);
    --article-body-font: Georgia, "Times New Roman", serif;
    --article-paragraph-gap: 1.25rem;
    --media-ratio: 16 / 9;
  }

  .article-header {
    display: grid;
    gap: 0.75rem;
  }

  .headline,
  .byline {
    margin: 0;
  }

  .headline {
    color: var(--dark-red);
    font: 400 clamp(2rem, 3.5vw, 4rem) / 1.1 var(--article-headline-font);
    font-weight: 700;
  }

  .byline {
    font: var(--article-headline-font)
    font-weight: 700;
    margin-bottom: 1.7vw
  }

  .article-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--article-paragraph-gap);
    font: 400 clamp(1.0625rem, 1.5vw, 1.25rem) / 1.65 var(--article-body-font);
  }

  .article-body :global(:is(h2, h3, h4, h5, h6, p, figure)) {
    margin: 0;
  }

  .article-body :global(:is(h2, h3, h4, h5, h6)) {
    font: 700 clamp(1.5rem, 3vw, 2.25rem) / 1.15 var(--font-body);
    color: var(--dark-red);
  }

  .article-body :global(figcaption) {
    margin-top: 0.5rem;
  }

  .article-body :global(.story-photo) {
    width: fit-content;
    max-width: 100%;
  }

  .article-body :global(.story-photo > figcaption) {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    font: 400 0.875rem / 1.35 Georgia, serif;
    text-align: left;
  }

  .article-body :global(.story-photo .photo-credit) {
    text-align: right;
  }

  @media (max-width: 700px) {
    .story-content {
      width: calc(100% - 2rem);
    }

    .article-body :global(.story-photo > figcaption) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
