---
import { Image } from 'astro:assets';
import background from '../assets/Background.png';
import hero from '../assets/hero/hero.png';
import mmss from '../assets/hero/MMSS.png';
import isp from '../assets/hero/ISP.png';
import loc from '../assets/hero/LOC.png';

const artworkRatio = hero.width / hero.height;
// Hit areas surround the lettering on each transparent PNG's original canvas.
const stories = [
  { id: 'mmss', label: 'MMSS', image: mmss, x: 975, y: 680, width: 585, height: 420 },
  { id: 'isp', label: 'ISP', image: isp, x: 1560, y: 1010, width: 465, height: 430 },
  { id: 'loc', label: 'LOC', image: loc, x: 960, y: 1220, width: 540, height: 430 },
];
---

<section id="soup" class="hero" aria-label="Alphabet Soup" tabindex="-1" style={`--artwork-ratio: ${artworkRatio}; background-image: url("${background.src}")`}>
  <div class="hero-artwork">
    <Image
      src={hero}
      alt="Alphabet Soup from The Daily Northwestern"
      format="png"
      width={1800}
      widths={[1200, 1800, 2400, 3200, hero.width]}
      sizes={`${artworkRatio * 100}dvh`}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <nav class="story-nav" aria-label="Alphabet Soup stories">
    {stories.map(({ id, label, image, x, y, width, height }) => {
      // The bowl moved 240 px left and 20 px down on the replacement canvas.
      const left = (x + width / 2 - 240) / hero.width * 100;
      const top = (y + height / 2 + 20) / hero.height * 100;
      return (
        <a
          href={`#${id}`}
          style={`--button-x: ${left}%; --button-y: ${top}%; --button-width: ${width / hero.width * 100}%; --button-ratio: ${width} / ${height}`}
        >
          <Image
            src={image}
            alt={label}
            format="png"
            width={1800}
            loading="eager"
            style={`--lettering-width: ${image.width / width * 100}%; --lettering-x: ${-x / width * 100}%; --lettering-y: ${-y / height * 100}%`}
          />
        </a>
      );
    })}
  </nav>
  <div class="hero-intro">
    <div class="editors-note" role="region" aria-label="Editor's Note" tabindex="0">
      <p>Pop quiz: What does MMSS stand for? How about ISP? LOC, anyone? To some, these acronyms may just be “alphabet soup.” To others, they describe the unique academic programs that define their Northwestern academic experience.</p>
      <p>Generally speaking, there’s little confusion about what “traditional” majors — like political science, engineering or communications, for instance — entail. But at NU, a student could be best friends with someone whose degree title is too complicated to explain in one or two words.</p>
      <p>With our busy schedules and demanding coursework, it can be hard to turn to a roommate and ask, “What do you actually study?”</p>
      <p>The Daily’s Alphabet Soup project highlights the unique interdisciplinary programs that set NU and its students apart. We asked students, faculty and alumni to go beyond the short, snappy acronyms and explain what skills students actually take away from NU’s most specialized programs.</p>
      <p>— Jack Greenspan, Multimedia Features Editor</p>
    </div>
  </div>
</section>

<style>
  .hero {
    --available-height: calc(var(--slide-viewport, 100dvh) - var(--header-height));
    position: relative;
    height: var(--available-height);
    isolation: isolate;
    background-color: var(--bright-yellow);
    background-position: center;
    background-size: cover;
  }

  .hero-artwork {
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .hero-artwork img {
    width: auto;
    max-width: none;
    height: 100%;
    object-fit: contain;
  }

  .story-nav {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(100%, calc(var(--available-height) * var(--artwork-ratio)));
    z-index: 1;
    pointer-events: none;
  }

  .story-nav a {
    position: absolute;
    left: var(--button-x);
    top: var(--button-y);
    width: max(64px, var(--button-width));
    aspect-ratio: var(--button-ratio);
    translate: -50% -50%;
    overflow: hidden;
    border-radius: 0.5rem;
    pointer-events: auto;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .story-nav a {
      transition: transform 250ms cubic-bezier(0.2, 0.75, 0.35, 1.1);
    }

    .story-nav a:is(:hover, :focus-visible) {
      transform: scale(1.12);
    }
  }

  .story-nav img {
    position: absolute;
    top: var(--lettering-y);
    left: var(--lettering-x);
    width: var(--lettering-width);
    max-width: none;
    height: auto;
  }

  .hero-intro {
    position: absolute;
    inset: 33% 0 0 48%;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(0.5rem, 2.5vw, 3rem);
    pointer-events: none;
  }

  .editors-note {
    width: min(100%, 35rem);
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    padding-inline: 0.375rem;
    color: var(--dark-red);
    font: 400 clamp(0.8125rem, 1.15vw, 1.25rem) / 1.3 "aglet-sans", sans-serif;
    text-align: center;
    -webkit-text-stroke: 2px var(--tan);
    paint-order: stroke fill;
    pointer-events: auto;
  }

  .editors-note p {
    margin: 0;
  }

  .editors-note p + p {
    margin-block-start: 0.75em;
  }
</style>
