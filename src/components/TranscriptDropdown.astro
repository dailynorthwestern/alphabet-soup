---
interface Props {
  transcript?: string;
}

const { transcript = 'Transcript placeholder' } = Astro.props;
---

<details>
  <summary>Read transcript</summary>
  <slot><p>{transcript}</p></slot>
</details>

<style>
  summary {
    cursor: pointer;
    color: var(--dark-red);
    font-weight: 700;
    width: fit-content;
  }

  details > :global(p) {
    margin: 0.5rem 0 0;
    white-space: pre-line;
  }
</style>
