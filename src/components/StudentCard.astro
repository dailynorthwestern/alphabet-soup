---
import AudioPlayer from './AudioPlayer.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';
import TranscriptDropdown from './TranscriptDropdown.astro';

interface Props {
  storyTitle: string;
  image?: { src: string; alt: string };
  quote?: string;
  audioSrc?: string;
  audioPeaks?: number[];
  transcript?: string;
}

const { storyTitle, image, quote, audioSrc, audioPeaks, transcript } = Astro.props;
---

<section class="interview-card" aria-label={`${storyTitle} student introduction`}>
  <div class="interview-grid">
    <div class="student-media">
      {image
        ? <img src={image.src} alt={image.alt} loading="lazy" />
        : <div class="student-photo-placeholder">
            <MediaPlaceholder label="Student profile photo placeholder" />
          </div>}
      <AudioPlayer src={audioSrc} peaks={audioPeaks} />
      <TranscriptDropdown transcript={transcript} />
    </div>
    <div class="student-quote">
      {quote ? <blockquote>{quote}</blockquote> : <p>Student quote placeholder</p>}
    </div>
  </div>
</section>

<style>
  .student-media {
    display: grid;
    gap: 0.625rem;
    --media-ratio: 4 / 3;
  }

  img {
    width: auto;
    max-width: min(100%, var(--student-portrait-width, 100%));
    height: auto;
  }

  @media (min-width: 701px) {
    img {
      max-height: var(--student-portrait-height);
    }

    .student-photo-placeholder {
      width: min(100%, calc(var(--student-portrait-height) * 4 / 3));
    }
  }

  .student-quote {
    font: 400 clamp(2.25rem, min(5vw, 7.5vh), 6rem) / 1.04 var(--font-display);
    color: var(--dark-red);
  }

  blockquote,
  p {
    margin: 0;
  }
</style>
